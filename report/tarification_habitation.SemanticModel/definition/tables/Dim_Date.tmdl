	column 'Avec données' =
			
			Dim_Date[Date] <= MAX ( Sinistres[date_survenance] )
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: bbb18b1b-b46e-491e-a228-b00e3b903a12
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Dim_Date = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR (
				        DATE ( YEAR ( MIN ( Polices[date_effet] ) ), 1, 1 ),
				        DATE ( YEAR ( MAX ( Sinistres[date_survenance] ) ), 12, 31 )
				    ),
				    "Année", YEAR ( [Date] ),
				    "Trimestre", "T" & QUARTER ( [Date] ),
				    "Mois num", MONTH ( [Date] ),
				    "Mois", FORMAT ( [Date], "mmm" ),
				    "Année-Mois", FORMAT ( [Date], "yyyy-mm" )
				)

	annotation PBI_Id = be81f8b15caa401f93f519f181787474

